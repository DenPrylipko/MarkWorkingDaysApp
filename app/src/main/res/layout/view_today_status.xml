<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewMainLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_stroke_full_day"
    android:padding="20dp">

    <!-- layout date -->
    <LinearLayout
        android:id="@+id/layoutDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="20dp"
            android:text="17"
            android:textColor="@color/primary"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTodayLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/dialog_today"
            android:textStyle="bold"
            android:textColor="@color/secondary_text"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- layout day status -->
    <LinearLayout
        android:id="@+id/layoutDayStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvDayStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/view_text"
            android:layout_marginHorizontal="5dp"
            android:text="@string/view_worked"
            android:textSize="20sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/dayType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvDayTypeFull"
            style="@style/choseType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/shape_bg_label"
            android:backgroundTint="@color/full_day"
            android:paddingHorizontal="28dp"
            android:visibility="visible"
            android:paddingVertical="4dp"
            android:text="@string/dialog_full_day"
            android:textColor="@color/dialog_text" />

        <TextView
            android:id="@+id/tvDayTypeShort"
            style="@style/choseType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/shape_bg_label"
            android:backgroundTint="@color/short_day"
            android:paddingHorizontal="28dp"
            android:visibility="gone"
            android:paddingVertical="4dp"
            android:text="@string/dialog_short_day"
            android:textColor="@color/dialog_text" />

        <TextView
            android:id="@+id/tvDayTypeNotWorked"
            style="@style/choseType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/shape_bg_label"
            android:backgroundTint="@color/not_worked"
            android:visibility="gone"
            android:paddingHorizontal="28dp"
            android:paddingVertical="4dp"
            android:text="@string/dialog_not_worked"
            android:textColor="@color/dialog_text" />

        </FrameLayout>


    </LinearLayout>

    <!-- layout bottom -->
    <FrameLayout
        android:id="@+id/layoutBottom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutDayStatus">

        <!-- layout tap to set -->
        <LinearLayout
            android:id="@+id/layoutTapToSet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivIconTapToSet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_icon_tap"
                android:src="@drawable/ic_touch_app" />

            <TextView
                android:id="@+id/tvTapToSet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/view_tap_to_set"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- layout day info -->
        <LinearLayout
            android:id="@+id/layoutDayInfo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">


            <TextView
                android:id="@+id/tvBonus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:textSize="18sp"
                android:textColor="@color/view_text"
                android:text="@string/view_bonus"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNoteView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:textColor="@color/view_text"
                android:textSize="18sp"
                android:text="@string/view_no_note"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEarned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:textColor="@color/view_text"
                android:background="@drawable/shape_bg_label"
                android:backgroundTint="@color/view_earned_bg"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:text="@string/view_earned"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>